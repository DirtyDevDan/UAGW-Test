{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "united-azeroth-guild-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ALLOWED_ORIGINS": "https://dirtydevdan.github.io,http://127.0.0.1:4173,http://localhost:4173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "united-azeroth-guild",
      "database_id": "8bb947f1-cb44-4de3-9db5-765013bff334",
      "migrations_dir": "worker/migrations"
    }
  ]
}
